# Operon Environment Configuration Template
# Copy this to .env.local for development or .env.prod for staging/production

# ============================================================================
# Application Configuration
# ============================================================================

# Environment: development, staging, production
ENV=development

# Debug mode (true for development, false for production)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://[user]:[REDACTED]@[host]:[port]/[database]
DATABASE_URL=postgresql://operon_user:[REDACTED]@postgres:5432/operon_dev

# ============================================================================
# AI Provider Configuration
# ============================================================================

# Active AI provider: ollama, anthropic, openai
# For development: use ollama (free, local)
AI_PROVIDER=ollama

# Ollama configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_NAME=llama2

# Anthropic Claude (requires API key)
# Leave empty if using ollama
ANTHROPIC_API_KEY=

# OpenAI GPT (requires API key)
# Leave empty if using ollama
OPENAI_API_KEY=

# ============================================================================
# Background Jobs Configuration
# ============================================================================

# Enable background job processing
BACKGROUND_WORKER_ENABLED=true

# Maximum concurrent jobs
MAX_CONCURRENT_JOBS=3

# Job timeout in seconds
JOB_TIMEOUT_SECONDS=300

# Number of retry attempts for failed jobs
JOB_RETRY_ATTEMPTS=3

# ============================================================================
# Authentication & Security (for production)
# ============================================================================

# Secret key for JWT tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# CRITICAL: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================================
# Frontend Configuration
# ============================================================================

# API base URL for frontend (relative path is recommended)
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================================
# Hosting & Deployment (for staging/production)
# ============================================================================

# Production database password (use strong password in production)
DB_PASSWORD=operon_password

# Domain name for Caddy reverse proxy (production only)
# DOMAIN=yourdomain.com

# ============================================================================
# Notes for Development
# ============================================================================
#
# 1. For local development: use ollama (free, no API key needed)
#    - Models will be auto-downloaded on first use
#    - Run: docker exec operon_ollama ollama list
#
# 2. To switch providers:
#    - Change AI_PROVIDER to "anthropic" or "openai"
#    - Provide the corresponding API key
#    - Restart: docker compose restart backend
#
# 3. For production/staging:
#    - Generate a strong SECRET_KEY
#    - Use environment variables for sensitive values
#    - Never commit real API keys or passwords
#
# 4. Database:
#    - Migrations run automatically on container start
#    - To manually run: docker exec operon_backend alembic upgrade head
#    - To create migration: docker exec operon_backend alembic revision --autogenerate -m "message"
#
