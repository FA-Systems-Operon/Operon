# Copy to .env and adjust as needed.
# Ollama runs on the host, not in Docker.

DEBUG=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required. The team model (see "Model choice" in backend/README.md).
# Pull it first: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b
# Seconds to wait for one model reply. 120 is enough with a GPU. On a CPU-only
# machine one 14b reply can take 15 minutes: use 1800 and JOB_TIMEOUT_SECONDS=3600.
OLLAMA_TIMEOUT_SECONDS=120
# How long one onboarding job may run before it counts as abandoned.
# Keep it above OLLAMA_TIMEOUT_SECONDS (a job can make 2 model calls).
JOB_TIMEOUT_SECONDS=600

# Required. Compose interpolates this into POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://operon:${POSTGRES_PASSWORD}@db:5432/operon

# Document storage, for running the backend outside Docker (compose sets its own).
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=20971520
