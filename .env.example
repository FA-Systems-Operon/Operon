# Application
DEBUG=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Database (local dev). compose.yaml uses POSTGRES_PASSWORD for the postgres container.
# DATABASE_URL is for running the backend or pytest on your machine, not in Docker.
POSTGRES_PASSWORD=operon_dev_password
DATABASE_URL=postgresql://operon_user:operon_dev_password@localhost:5432/operon_dev

# Document storage. STORAGE_DIR is where uploaded files are saved (a volume in Docker).
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=20971520
