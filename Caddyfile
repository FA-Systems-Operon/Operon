# Caddyfile for Operon production deployment
# Configure your domain in the environment or replace {$DOMAIN} with your actual domain

(common) {
	encode gzip
	header {
		# Security headers
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$DOMAIN:localhost} {
	import common

	# API routes
	handle /api* {
		reverse_proxy backend:8000
	}

	# Health checks
	handle /health {
		reverse_proxy backend:8000
	}

	# Default to frontend
	reverse_proxy frontend:5173
}
