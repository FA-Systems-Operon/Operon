# Local Development Environment
# Copy from .env.example and customize as needed

# Application
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql://operon_user:[REDACTED]@postgres:5432/operon_dev

# AI Provider (use ollama for local development - no API key needed)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_NAME=llama2

# Leave these empty for local dev with ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Background Jobs
BACKGROUND_WORKER_ENABLED=true
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_ATTEMPTS=3

# Auth (for local dev only)
SECRET_KEY=dev-secret-key-change-in-production

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
