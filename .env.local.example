# Local development. Copy to .env if you want to override Compose defaults.
# Ollama runs on the host, not in Docker.

ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+psycopg://operon:operon@db:5432/operon

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required. Set this to a model you have pulled (ollama list).
OLLAMA_MODEL=

# Leave empty when using local Ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

BACKGROUND_WORKER_ENABLED=true
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_ATTEMPTS=3

SECRET_KEY=dev-secret-key-change-in-production

VITE_API_BASE_URL=http://localhost:8000/api
